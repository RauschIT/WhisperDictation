<Window x:Class="WhisperDictation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="Assets/app-mic.ico"
        Title="Whisper Dictation" SizeToContent="Height" Width="420"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status -->
        <Border Grid.Row="0" Background="#E8E8E8" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Text="Lade..." FontSize="18" FontWeight="Bold"
                       Foreground="#0078D7" HorizontalAlignment="Center"/>
        </Border>

        <!-- Parameter -->
        <GroupBox Grid.Row="1" Header="Parameter" Margin="0,0,0,10" Padding="5">
            <StackPanel>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Model" VerticalAlignment="Center"/>
                    <!-- Filled at runtime with the ggml-*.bin files in the model folder. -->
                    <ComboBox x:Name="ModelCombo" Grid.Column="1" SelectionChanged="OnWhisperSettingChanged"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Compute" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DeviceCombo" Grid.Column="1" SelectionChanged="OnWhisperSettingChanged">
                        <ComboBoxItem Tag="gpu" Content="GPU (Vulkan)"/>
                        <ComboBoxItem Tag="cpu" Content="CPU"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hotkey" VerticalAlignment="Center"/>
                    <ComboBox x:Name="HotkeyModeCombo" Grid.Column="1"
                              SelectionChanged="OnHotkeyModeChanged">
                        <ComboBoxItem Tag="CtrlSpace" Content="Ctrl + Space"/>
                        <ComboBoxItem Tag="CtrlDoubleTap" Content="Double-Tap Ctrl"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Language" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Tag="de" Content="Deutsch"/>
                        <ComboBoxItem Tag="en" Content="Englisch"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Noise suppression" VerticalAlignment="Center"/>
                    <Slider x:Name="VadModeSlider" Grid.Column="1" Minimum="0" Maximum="3"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="OnParameterChanged"/>
                    <TextBlock x:Name="VadModeValue" Grid.Column="2" Text="High" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Min. Stille (ms)" VerticalAlignment="Center"/>
                    <Slider x:Name="MinSilenceSlider" Grid.Column="1" Minimum="50" Maximum="500"
                            TickFrequency="10" IsSnapToTickEnabled="False"
                            ValueChanged="OnParameterChanged"/>
                    <TextBlock x:Name="MinSilenceValue" Grid.Column="2" Text="160" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Min. speech (ms)" VerticalAlignment="Center"/>
                    <Slider x:Name="MinSpeechSlider" Grid.Column="1" Minimum="100" Maximum="1000"
                            TickFrequency="50" IsSnapToTickEnabled="False"
                            ValueChanged="OnParameterChanged"/>
                    <TextBlock x:Name="MinSpeechValue" Grid.Column="2" Text="250" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wort-Delay (ms)" VerticalAlignment="Center"/>
                    <Slider x:Name="WordDelaySlider" Grid.Column="1" Minimum="0" Maximum="300"
                            TickFrequency="10" IsSnapToTickEnabled="False"
                            ValueChanged="OnParameterChanged"/>
                    <TextBlock x:Name="WordDelayValue" Grid.Column="2" Text="60" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Hotwords -->
        <GroupBox Grid.Row="2" Header="Hotwords (Prompt)" Padding="5">
            <TextBox x:Name="HotwordsText" Height="110" TextWrapping="Wrap" AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     Text=""
                     LostFocus="OnHotwordsChanged"/>
        </GroupBox>
    </Grid>
</Window>
